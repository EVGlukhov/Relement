{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@jgluhov/relement",
    "paths": {
      "@jgluhov/relement/jsx-runtime": ["./src/jsx-runtime.js"]
    }
  },
  "include": [
    "src/*.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "docs/app/**/*.d.ts",
    "docs/app/**/*.tsx",
    "relement.config.ts",
    "scripts/dev-server/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
