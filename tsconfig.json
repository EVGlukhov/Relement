{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "src/*.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "docs/app/**/*.d.ts",
    "docs/app/**/*.tsx"
  ]
}
