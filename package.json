{
  "name": "@jgluhov/relement",
  "version": "0.1.0",
  "description": "A lightweight JavaScript UI framework built on native Custom Elements.",
  "license": "ISC",
  "author": "",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/EVGlukhov/Relement#readme",
  "bugs": {
    "url": "https://github.com/EVGlukhov/Relement/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVGlukhov/Relement.git"
  },
  "scripts": {
    "build": "tsc && node scripts/build-css-modules.mjs",
    "build:dev": "npm run build && node scripts/dev-server/inject-hmr.mjs",
    "build:docs": "npm run build && node scripts/build-docs.mjs",
    "dev": "node scripts/dev-server/watch-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "files": [
    "dist/src"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "import": "./dist/src/jsx-runtime.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.95.0",
    "postcss": "^8.5.33",
    "postcss-modules": "^9.1.4",
    "typescript": "^7.0.2"
  }
}
