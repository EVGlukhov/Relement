{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "overrides": [
    {
      "files": ["test/**/*.test.ts", "test/**/*.test.tsx"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
