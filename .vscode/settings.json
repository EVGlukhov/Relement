{
  "cSpell.words": ["Relement", "topbar", "vnode"],
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.exclude": {
    "**/.history": true
  },
  "search.exclude": {
    "**/.history": true
  },
  "files.watcherExclude": {
    "**/.history/**": true
  },
  "typescript.preferences.autoImportFileExcludePatterns": ["**/.history/**"]
}
